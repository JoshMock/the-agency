{
  "name": "@the-agency/pi-coordinator",
  "version": "0.1.0",
  "description": "Plan a task before running it: ask the questions that would change the plan, name the repos, and write a reviewable pi-task-tree document.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "npm run lint && node --experimental-transform-types --test index.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "*.ts",
    "!*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "agents",
    "orchestration",
    "planning",
    "task-tree"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshMock/the-agency.git",
    "directory": "packages/coordinator"
  }
}
